# Copy this file to .env and fill in your own values. Never commit .env.
NODE_ENV=development
PORT=5000

# MongoDB connection string (MongoDB Atlas or a local mongod)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/breadbar

# Two different long random secrets, e.g. generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_CUSTOMER_SECRET=
JWT_STAFF_SECRET=

# One-time key used to create the single owner account. Remove or rotate after setup.
BUSINESS_SETUP_KEY=

# Comma-separated list of allowed front-end origins, e.g. http://localhost:3000
CORS_ORIGINS=
TRUST_PROXY=false
